APP_NAME="RCI - Roys Counsel Indonesia"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=rci_app
DB_USERNAME=postgres
DB_PASSWORD=
# Alternatif connection string tunggal (dipakai oleh render.yaml):
# DB_URL=postgresql://user:password@host:5432/database

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Chat saat ini tetap bekerja melalui polling. Gunakan null agar isi pesan
# tidak ditulis ke log; ubah ke reverb hanya jika server Reverb sudah disiapkan.
BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# ──────────────────────────────────────────────
# Bootstrap Admin (hanya membuat admin pertama; password tidak di-reset saat boot)
# ──────────────────────────────────────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME="RCI Admin"
ADMIN_PHONE=

# ──────────────────────────────────────────────
# Google OAuth
# ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/api/v1/auth/google/callback"

# ──────────────────────────────────────────────
# Supabase Storage (S3 Compatible)
# ──────────────────────────────────────────────
# FILESYSTEM_DISK=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=ap-southeast-1
# AWS_BUCKET=rci-documents
# AWS_ENDPOINT=https://<your-project-id>.supabase.co/storage/v1/s3
# AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"

# ──────────────────────────────────────────────
# AI Service (pilih salah satu atau keduanya)
# ──────────────────────────────────────────────
# Opsi 1: Google Gemini API (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Opsi 2: OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-flash-1.5-8b

# ──────────────────────────────────────────────
# Xendit Payment Gateway
# ──────────────────────────────────────────────
# Get your API key from: https://dashboard.xendit.co/settings/developers
# For development, use keys with the "xnd_development_" prefix.
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
XENDIT_INVOICE_DURATION=86400
XENDIT_SUCCESS_REDIRECT_URL=
XENDIT_FAILURE_REDIRECT_URL=

REVERB_APP_ID=rci-app
REVERB_APP_KEY=rci-local-key
REVERB_APP_SECRET=rci-local-secret
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
